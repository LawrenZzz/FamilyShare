<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃底部面板：半透明渐变 + 细描边高光 + 圆角 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 主玻璃面 -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:centerColor="@color/glass_surface"
                android:endColor="@color/glass_surface_strong"
                android:startColor="@color/glass_surface_weak" />
            <corners android:radius="@dimen/corner_panel" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
    <!-- 顶部一条内缘高光，强化玻璃质感 -->
    <item>
        <shape>
            <corners
                android:topLeftRadius="@dimen/corner_panel"
                android:topRightRadius="@dimen/corner_panel" />
            <gradient
                android:angle="90"
                android:endColor="@android:color/transparent"
                android:startColor="@color/glass_edge_shadow" />
            <size android:height="2dp" />
        </shape>
    </item>
</layer-list>