<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 高德地图 -->
    <com.amap.api.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 地图底部压暗渐变：让玻璃面板在图上更有层次（不拦截触摸） -->
    <View
        android:id="@+id/mapScrim"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_map_scrim_bottom"
        android:clickable="false"
        android:focusable="false" />

    <!-- 顶部玻璃操作条：刷新 + 家庭码 + 更多 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|top"
        android:background="@drawable/bg_glass_chip"
        android:elevation="@dimen/elevation_float"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/topbar_padding">

        <!-- 一键刷新 -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="@dimen/btn_float"
            android:layout_height="@dimen/btn_float"
            android:background="@drawable/bg_glass_btn"
            android:contentDescription="@string/menu_refresh"
            android:padding="10dp"
            android:src="@drawable/ic_refresh_svg"
            app:tint="@color/text_primary" />

        <!-- 家庭码入口（点开家庭码 + 二维码弹窗，复用原有 showCodeDialog） -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShowCode"
            style="@style/FamilyShare.Button.Glass"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/btn_float"
            android:layout_marginStart="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/btn_family_code"
            android:textSize="13sp"
            app:icon="@drawable/ic_dialpad"
            app:iconGravity="textStart"
            app:iconSize="@dimen/icon_md" />

        <!-- 更多操作（⋮） -->
        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btnOverflow"
            android:layout_width="@dimen/btn_float"
            android:layout_height="@dimen/btn_float"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_glass_btn"
            android:contentDescription="@string/btn_more"
            android:padding="10dp"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/text_primary" />
    </LinearLayout>

    <!-- 底部玻璃面板：状态 + 家人列表（可收缩）+ 定位按钮 -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:background="@drawable/bg_glass_panel"
        android:elevation="@dimen/elevation_panel"
        android:orientation="vertical"
        android:padding="@dimen/space_lg">

        <!-- 拖拽区 -->
        <View
            android:id="@+id/dragHandle"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_drag_handle_area" />

        <!-- 头部：返回 + 标题 + 响铃开关 + 状态胶囊 -->
        <LinearLayout
            android:id="@+id/panelHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btnBack"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_glass_btn"
                android:contentDescription="@string/btn_back"
                android:padding="6dp"
                android:src="@drawable/ic_back"
                android:visibility="gone"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_family_share"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- 响铃时显示：点击立即停止本机响铃 -->
            <TextView
                android:id="@+id/btnStopRing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/space_sm"
                android:background="@drawable/bg_ring_stop"
                android:paddingStart="@dimen/space_md"
                android:paddingEnd="@dimen/space_md"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/btn_stop_ring"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/dot_offline" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/status_connecting"
                    android:textColor="@color/status_pill_offline_text"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 可整体收缩的面板主体 -->
        <LinearLayout
            android:id="@+id/panelBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/space_md"
                android:background="@color/glass_stroke" />

            <TextView
                android:id="@+id/tvMemberCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- 成员列表 + 空状态 -->
            <LinearLayout
                android:id="@+id/listArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/memberList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:maxHeight="250dp"
                        android:overScrollMode="never" />

                    <View
                        android:id="@+id/listTopMore"
                        android:layout_width="match_parent"
                        android:layout_height="26dp"
                        android:layout_gravity="top"
                        android:background="@drawable/bg_fade_top"
                        android:clickable="false"
                        android:focusable="false"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/listBottomMore"
                        android:layout_width="match_parent"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom"
                        android:background="@drawable/bg_fade_bottom"
                        android:clickable="false"
                        android:focusable="false"
                        android:visibility="gone" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center"
                    android:text="@string/no_member_yet"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <!-- 空状态引导卡 -->
                <LinearLayout
                    android:id="@+id/emptyCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_glass_card"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingTop="18dp"
                    android:paddingBottom="16dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:alpha="0.85"
                        android:contentDescription="@string/empty_family_title"
                        android:src="@drawable/ic_people"
                        app:tint="@color/primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_sm"
                        android:text="@string/empty_family_title"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:gravity="center"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/empty_family_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyAction"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_md"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="38dp"
                        android:text="@string/empty_family_action"
                        android:textSize="13sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/glass_stroke" />
            </LinearLayout>

            <!-- 主操作：定位我 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLocateMe"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="46dp"
                android:text="@string/btn_locate_me"
                android:textSize="14sp"
                app:icon="@drawable/ic_my_location"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_sm"
                app:iconTint="@color/white" />

            <!-- 切换家庭 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSwitchFamily"
                style="@style/FamilyShare.Button.Glass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minHeight="42dp"
                android:text="@string/btn_switch_family"
                android:textSize="14sp"
                android:visibility="gone"
                app:icon="@drawable/ic_people"
                app:iconGravity="textStart"
                app:iconSize="@dimen/icon_md" />
        </LinearLayout>

        <!-- 成员详情（内嵌在悬浮窗口内查看） -->
        <LinearLayout
            android:id="@+id/detailArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 自绘刻度尺 -->
    <LinearLayout
        android:id="@+id/scaleBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="@dimen/space_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvScaleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_xs"
            android:background="@drawable/bg_scale_label"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            android:text="100米"
            android:textColor="@color/white"
            android:textSize="10sp" />

        <View
            android:id="@+id/scaleLine"
            android:layout_width="56dp"
            android:layout_height="14dp" />
    </LinearLayout>

</FrameLayout>