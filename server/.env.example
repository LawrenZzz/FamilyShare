# 把本文件复制成 .env 后填写真实值（docker compose 自动读取，切勿把真实值提交到 git）
#   cp .env.example .env

# ============ 访问口令（重要） ============
# 客户端 Android 的 gradle.properties 里 API_TOKEN 必须与这里的 APP_API_TOKEN 完全一致，
# 服务端 /api/**、/ws、/icons/** 都需要带它。建议用随机长字符串，例如：
#   openssl rand -hex 24
APP_API_TOKEN=CHANGE_ME_随机长字符串至少24位

# Bug 反馈管理页路径口令：访问 http(s)://你的域名/bugadmin/<这个值>
APP_BUG_ADMIN_TOKEN=CHANGE_ME_bug口令

# 只读状态看板路径口令：访问 http(s)://你的域名/dashboard/<这个值>
APP_DASHBOARD_TOKEN=CHANGE_ME_dash口令

# ============ Redis ============
# Redis AUTH 口令（至少 8 位，别用生日/123456）
REDIS_PASSWORD=CHANGE_ME_redis强口令